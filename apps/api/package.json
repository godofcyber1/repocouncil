{
  "name": "@repocouncil/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "replay:webhook": "tsx src/scripts/replay-webhook.ts",
    "review:baseline": "tsx src/scripts/run-baseline-review.ts",
    "validate:webhook-fixture": "tsx src/scripts/validate-webhook-fixture.ts"
  },
  "dependencies": {
    "@langchain/langgraph": "^0.2.0",
    "@octokit/auth-app": "^7.1.2",
    "@octokit/rest": "^21.1.1",
    "@prisma/client": "^6.0.0",
    "@repocouncil/shared": "0.1.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
