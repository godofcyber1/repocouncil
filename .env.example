NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://repocouncil:repocouncil@localhost:5432/repocouncil

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MODEL_PROVIDER=mock
# MODEL_PROVIDER can be mock, seeded, or qwen.

# Qwen / Alibaba Cloud Model Studio
# Use environment variables only. Never commit a real API key.
#
# General Bailian API keys usually look like: sk-xxxxx
# Coding Plan dedicated API keys usually look like: sk-sp-xxxxx
# Coding Plan may require its own dedicated Base URL from the Coding Plan console.
QWEN_API_KEY=your-qwen-api-key

# Base URL examples:
# Beijing / China North 2:
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# United States / Virginia:
# QWEN_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
# Singapore:
# QWEN_BASE_URL=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Germany / Frankfurt:
# QWEN_BASE_URL=https://{WorkspaceId}.eu-central-1.maas.aliyuncs.com/compatible-mode/v1

QWEN_MODEL_PLANNER=qwen-turbo
QWEN_MODEL_REVIEWER=qwen-turbo
# Referee is deterministic in the current MVP. This value is reserved for a future LLM judge mode.
QWEN_MODEL_REFEREE=qwen-turbo

WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Optional local repository root used for repo-context discovery in local review runs.
# Keep this empty in deployed environments unless the service has a checked-out repo.
REPOSITORY_ROOT=

# Optional local runtime evidence collection.
# When enabled and REPOSITORY_ROOT is set, review runs can execute local package scripts
# such as typecheck, lint, test, semgrep, and secret-scan if those scripts exist.
ENABLE_TOOL_EVIDENCE_RUNTIME=false
TOOL_EVIDENCE_TIMEOUT_MS=60000
