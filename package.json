{
  "name": "repocouncil",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-agent GitHub PR review system for the Qwen Cloud hackathon.",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @repocouncil/shared && npm run build -w @repocouncil/api && npm run build -w @repocouncil/web",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "dev:local": "set NO_PAUSE=1&& start-local.cmd",
    "dev:local:ngrok": "set NO_PAUSE=1&& start-local-ngrok.cmd",
    "dev:local:stop": "set NO_PAUSE=1&& stop-local.cmd",
    "dev:api": "npm run dev -w @repocouncil/api",
    "dev:web": "npm run dev -w @repocouncil/web",
    "execute:review-run": "npm run execute:review-run -w @repocouncil/api --",
    "eval": "npm run eval -w @repocouncil/api --",
    "eval:summary": "npm run eval:summary -w @repocouncil/api",
    "lint": "npm run lint --workspaces --if-present",
    "publish:review-run": "npm run publish:review-run -w @repocouncil/api --",
    "replay:webhook": "npm run replay:webhook -w @repocouncil/api",
    "rerun:review-run": "npm run rerun:review-run -w @repocouncil/api --",
    "review:baseline": "npm run build -w @repocouncil/shared && npm run review:baseline -w @repocouncil/api",
    "set:review-run-mode": "npm run set:review-run-mode -w @repocouncil/api --",
    "typecheck": "npm run build -w @repocouncil/shared && npm run typecheck -w @repocouncil/api && npm run typecheck -w @repocouncil/web",
    "validate:webhook-fixture": "npm run validate:webhook-fixture -w @repocouncil/api",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
